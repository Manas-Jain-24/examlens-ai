# ExamLens AI Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
MAX_UPLOAD_SIZE_MB=15

# Comma-separated browser origins permitted to call this API.
# Add your deployed frontend URL before production use.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Google Gemini API Key (Required for Phase 2 AI Features)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional absolute path for the local audit/revision/evaluation database.
# Default: .data/examlens.sqlite3 in the project directory (ignored by Git).
# HISTORY_DB_PATH=C:/path/to/examlens.sqlite3
