# ExamLens AI Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
MAX_UPLOAD_SIZE_MB=15

# Comma-separated browser origins permitted to call this API.
# Add your deployed frontend URL before production use.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Google Gemini API Key (Required for Phase 2 AI Features)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=
# Set GEMINI_MODEL to a model available to your Google account. No model is guessed.
AI_TIMEOUT_SECONDS=20

# Optional OCR, run locally. Requires Tesseract and Poppler on PATH.
OCR_ENABLED=false
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=60
MAX_PDF_PAGES=50
# Alternatively set absolute executable paths:
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# PDF_RENDERER_CMD=C:/path/to/pdftoppm.exe

# Portable JSON restore upload limit (saved history and reference labels).
MAX_BACKUP_SIZE_MB=50

# Optional absolute path for the local audit/revision/evaluation database.
# Default: .data/examlens.sqlite3 in the project directory (ignored by Git).
# HISTORY_DB_PATH=C:/path/to/examlens.sqlite3
